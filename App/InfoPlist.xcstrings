{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MyOpenScale"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MyOpenScale"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, wenn du deine Waage koppelst (Xiaomi Mi Body Composition Scale 2): empfängt ihre Messsignale in der Nähe, um dein Gewicht zu lesen. Die App verbindet sich nie mit der Waage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when you pair your scale (Xiaomi Mi Body Composition Scale 2): listens for its nearby weigh-in broadcasts to read your weight. The app never connects to the scale."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest dein Geburtsdatum, dein biologisches Geschlecht, deine Größe und deinen Gewichtsverlauf, um dein Profil einzurichten und aus den Messungen der Waage die Körperzusammensetzung zu berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your date of birth, biological sex, height, and weight history to set up your profile and compute body composition from scale readings."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert dein Gewicht, deinen Körperfettanteil, deine fettfreie Körpermasse und deinen BMI in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your weight, body fat percentage, lean body mass, and BMI to Apple Health."
          }
        }
      }
    }
  },
  "version": "1.0"
}