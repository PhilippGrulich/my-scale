{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, wenn du deine Waage koppelst (Xiaomi Mi Body Composition Scale 2): empfängt ihre Messsignale in der Nähe, um dein Gewicht zu lesen. Die App verbindet sich nie mit der Waage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when you pair your scale (Xiaomi Mi Body Composition Scale 2): listens for its nearby weigh-in broadcasts to read your weight. The app never connects to the scale."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Geburtsdatum, Geschlecht, Größe, Gewicht und Körperwerte, um dein Profil einzurichten und die Körperzusammensetzung zu schätzen, sowie Trainings, Schritte, Aktiv- und Nahrungsenergie, um sie im Verlauf zu zeigen und Mochi jubeln zu lassen. Nichts verlässt deine Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your date of birth, sex, height, weight and body measurements to set up your profile and estimate body composition, and your workouts, steps, active and dietary energy to show them in your history and let Mochi cheer you on. Nothing leaves your devices."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert dein Gewicht, deinen Körperfettanteil, deine fettfreie Körpermasse und deinen BMI in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your weight, body fat percentage, lean body mass, and BMI to Apple Health."
          }
        }
      }
    }
  },
  "version": "1.0"
}