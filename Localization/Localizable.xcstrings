    },
    "Weigh in to see your trend.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich, um deinen Trend zu sehen."
          }
        }
      }
    },
    "Weigh-in saved": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung gesichert"
          }
        }
      }
    },
    "Weigh-ins from your scale, manual entries and Apple Health appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messungen deiner Waage, manuelle Einträge und Daten aus Apple Health erscheinen hier."
          }
        }
      }
    },
    "Weigh-ins with body fat, lean mass and BMI are then saved automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messungen mit Körperfett, fettfreier Masse und BMI werden dann automatisch gesichert."
          }
        }
      }
    },
    "Weighed in on %lld of the last 14 days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %lld der letzten 14 Tage gewogen"
          }
        }
      }
    },
    "Weighing in most days makes your trend and forecast more reliable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dich an den meisten Tagen wiegst, werden Trend und Prognose genauer."
          }
        }
      }
    },
    "Weight": {
