    },
    "You're all set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit"
          }
        }
      }
    },
    "You're inside the healthy range — %@ kg above its lower and %@ kg below its upper end.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du liegst im gesunden Bereich – %1$@ kg über der Unter- und %2$@ kg unter der Obergrenze."
