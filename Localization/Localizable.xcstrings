            "value": "Viszeralfett"
          }
        }
      }
    },
    "Waiting for your scale… stand still once you're on and the reading will start automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf deine Waage … Bleib ruhig stehen, sobald du drauf bist – die Messung startet automatisch."
