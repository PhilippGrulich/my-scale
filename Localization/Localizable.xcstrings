    "BMI": {
      "shouldTranslate": false
    },
    "BMI %@": {
      "shouldTranslate": false
    },
    "BMI = weight ÷ height²": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI = Gewicht ÷ Größe²"
          }
        }
      }
    },
    "BMI at goal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI beim Ziel"
          }
        }
      }
    },
    "BMI only relates weight to height. It can't tell muscle from fat, so very muscular people can show a high BMI while being lean — and a normal BMI can still hide a high body-fat share.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der BMI setzt nur Gewicht und Größe ins Verhältnis. Er unterscheidet nicht zwischen Muskeln und Fett – sehr muskulöse Menschen können einen hohen BMI haben und trotzdem schlank sein, und ein normaler BMI kann einen hohen Körperfettanteil verbergen."
          }
        }
      }
    },
    "Basal metabolic rate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundumsatz"
