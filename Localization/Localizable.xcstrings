    "A %@ kg weigh-in needs confirming.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Messung mit %@ kg muss bestätigt werden."
          }
        }
      }
    },
    "A rating for the fat around your inner organs. It is more strongly linked to health risks than fat under the skin: 1–9 is healthy, 10–14 high, 15 and above very high.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wert für das Fett um deine inneren Organe. Es hängt stärker mit Gesundheitsrisiken zusammen als Fett unter der Haut: 1–9 ist gesund, 10–14 hoch, ab 15 sehr hoch."
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        }
      }
    },
    "Add a body-fat goal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körperfett-Ziel hinzufügen"
          }
        }
      }
    },
    "Add a first weigh-in to set a goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag zuerst eine Messung ein, um ein Ziel festzulegen."
          }
        }
      }
    },
