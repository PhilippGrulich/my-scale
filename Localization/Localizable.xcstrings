          }
        }
      }
    },
    "Your weigh-ins are recognised automatically from your weight and body-composition signature — no weight range to configure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Messungen werden automatisch an deinem Gewicht und deiner Körperzusammensetzung erkannt – kein Gewichtsbereich nötig."
