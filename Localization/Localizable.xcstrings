    },
    "Age": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter"
          }
        }
      }
    },
    "Almost there — keep your feet on the scale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast geschafft – bleib mit beiden Füßen auf der Waage."
          }
        }
      }
    },
    "An estimate of the mineral weight of your skeleton. It changes very slowly; the scale derives it from your lean mass, so it is a rough guide only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schätzung des Mineralgewichts deines Skeletts. Sie ändert sich sehr langsam; die Waage leitet sie aus der fettfreien Masse ab – also nur ein grober Anhaltspunkt."
          }
        }
      }
    },
    "Apple Health": {
      "shouldTranslate": false
    },
    "At %@ kg per week you'll reach %@ kg around %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@ kg pro Woche erreichst du %2$@ kg voraussichtlich am %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "At %1$@ kg per week you'll reach %2$@ kg around %3$@."
          }
        }
      }
    },
    "At %@ kg per week, reaching %@ kg would take more than two years.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@ kg pro Woche würde es mehr als zwei Jahre dauern, %2$@ kg zu erreichen."
