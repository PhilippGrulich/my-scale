    "Weigh in on the scale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Waage wiegen"
          }
        }
      }
    },
    "Weigh in on your scale to see this value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich auf deiner Waage, um diesen Wert zu sehen."
          }
        }
      }
    },
    "Weigh in on your scale to track body fat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich auf deiner Waage, um dein Körperfett zu verfolgen."
          }
