    "Your real age is %lld. A metabolic age below it is favourable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein echtes Alter ist %lld. Ein Stoffwechselalter darunter ist günstig."
          }
        }
      }
    },
    "Your scale measured a body fat of %@ %%, which says more about body composition than BMI alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Waage hat einen Körperfettanteil von %@ %% gemessen – das sagt mehr über deine Körperzusammensetzung als der BMI allein."
          }
        }
      }
    },
    "Your total daily calorie need is roughly 1.2× this when sitting most of the day, up to 1.7× when very active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gesamter Tagesbedarf liegt etwa beim 1,2-Fachen, wenn du viel sitzt, und bis zum 1,7-Fachen, wenn du sehr aktiv bist."
          }
        }
      }
    },
    "Your trend is %@ kg above your goal.": {
