        }
      }
    },
    "Walking": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen"
          }
        }
      }
    },
    "Was this you?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warst du das?"
          }
        }
      }
    },
    "We need your height to compute weight and body composition.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Größe wird benötigt, um Gewicht und Körperzusammensetzung zu berechnen."
          }
        }
      }
    },
    "We'll read your age, height and biological sex to calculate body composition, and save each weigh-in back to Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir lesen dein Alter, deine Größe und dein biologisches Geschlecht, um die Körperzusammensetzung zu berechnen, und sichern jede Messung in Health."
          }
        }
      }
    },
    "Weigh In": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiegen"
          }
        }
      }
    },
    "Weigh in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiegen"
          }
        }
      }
    },
    "Weigh in again to see how this value develops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich noch einmal, um zu sehen, wie sich dieser Wert entwickelt."
          }
        }
      }
    },
    "Weigh in again to see how your BMI develops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich noch einmal, um zu sehen, wie sich dein BMI entwickelt."
          }
        }
      }
    },
    "Weigh in again to start seeing your trend.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg dich noch einmal, um deinen Trend zu sehen."
          }
        }
      }
    },
    "Weigh in for a few more days to get a forecast.": {
      "localizations": {
