      }
    },
    "Step on your body-composition scale and your weigh-ins flow straight into Apple Health — body fat, lean mass and BMI computed on-device. No accounts, no cloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
